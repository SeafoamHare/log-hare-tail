{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${hostSystemName}/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ci",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": { "LOGGER_WERROR": "ON" }
        },
        {
            "name": "dev",
            "displayName": "Local development build with the default compiler",
            "inherits": "base"
        },
        {
            "name": "gcc",
            "displayName": "GCC, warnings as errors",
            "inherits": "ci",
            "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
        },
        {
            "name": "clang",
            "displayName": "Clang, warnings as errors",
            "inherits": "ci",
            "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
        },
        {
            "name": "tsan",
            "displayName": "Clang + ThreadSanitizer",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -O1"
            }
        },
        {
            "name": "asan",
            "displayName": "Clang + AddressSanitizer + UndefinedBehaviorSanitizer",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -O1"
            }
        },
        {
            "name": "release",
            "displayName": "Optimized demo build without tests (used by the Docker image)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "LOGGER_BUILD_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        { "name": "dev", "configurePreset": "dev" },
        { "name": "gcc", "configurePreset": "gcc" },
        { "name": "clang", "configurePreset": "clang" },
        { "name": "tsan", "configurePreset": "tsan" },
        { "name": "asan", "configurePreset": "asan" },
        { "name": "release", "configurePreset": "release" }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "jobs": 4 }
        },
        { "name": "dev", "inherits": "base", "configurePreset": "dev" },
        { "name": "gcc", "inherits": "base", "configurePreset": "gcc" },
        { "name": "clang", "inherits": "base", "configurePreset": "clang" },
        { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
        { "name": "asan", "inherits": "base", "configurePreset": "asan" }
    ],
    "workflowPresets": [
        {
            "name": "dev",
            "steps": [
                { "type": "configure", "name": "dev" },
                { "type": "build", "name": "dev" },
                { "type": "test", "name": "dev" }
            ]
        },
        {
            "name": "gcc",
            "steps": [
                { "type": "configure", "name": "gcc" },
                { "type": "build", "name": "gcc" },
                { "type": "test", "name": "gcc" }
            ]
        },
        {
            "name": "clang",
            "steps": [
                { "type": "configure", "name": "clang" },
                { "type": "build", "name": "clang" },
                { "type": "test", "name": "clang" }
            ]
        },
        {
            "name": "tsan",
            "steps": [
                { "type": "configure", "name": "tsan" },
                { "type": "build", "name": "tsan" },
                { "type": "test", "name": "tsan" }
            ]
        },
        {
            "name": "asan",
            "steps": [
                { "type": "configure", "name": "asan" },
                { "type": "build", "name": "asan" },
                { "type": "test", "name": "asan" }
            ]
        },
        {
            "name": "release",
            "steps": [
                { "type": "configure", "name": "release" },
                { "type": "build", "name": "release" }
            ]
        }
    ]
}
